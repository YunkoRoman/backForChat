# Docker Compose environment variables
# Copy to .env and customize for your setup

NODE_ENV=development
PORT=3000

# MongoDB
MONGO_URI=mongodb://mongo:27017/chat

# RabbitMQ
RABBITMQ_URL=amqp://guest:guest@rabbitmq:5672

# JWT Secrets (IMPORTANT: Change these in production!)
JWT_ACCESS_SECRET=your_access_secret_min_32_chars_here
JWT_REFRESH_SECRET=your_refresh_secret_min_32_chars_here

# Frontend URL (for CORS)
FRONTEND_ORIGIN=http://localhost:8000

# API URL for frontend build (must match the HOST-published api port in
# docker-compose.yml, which is 13000 - the browser calls this directly)
VITE_API_URL=http://localhost:13000/api/v1
